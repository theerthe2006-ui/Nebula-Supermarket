# Nebula Supermarket Platform - Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Relative to project root or absolute)
DATABASE_PATH=./data/supermarket.db

# Client / Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Authentication Security Secrets
JWT_SECRET=nebula_supermarket_jwt_secret_key_change_in_production_2026
SESSION_SECRET=nebula_supermarket_session_secret_key_2026

# Provider Integration Architecture (Optional External Credentials)
# Email Notification Provider (SMTP / Resend / SendGrid)
EMAIL_PROVIDER=DEMO
EMAIL_API_KEY=
EMAIL_FROM=support@nebulamarket.local

# SMS OTP Provider (Twilio / MSG91)
SMS_PROVIDER=DEMO
SMS_API_KEY=

# Payment Gateway Sandbox Credentials (Razorpay / Stripe)
PAYMENT_PROVIDER=DEMO_PAYMENT
PAYMENT_KEY=
PAYMENT_SECRET=
